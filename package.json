{
  "name": "baileys-interactive",
  "version": "7.0.0-rc14.1",
  "type": "module",
  "description": "@whiskeysockets/baileys 7.0.0-rc14 with button and interactive message support, drop-in compatible",
  "keywords": [
    "whatsapp",
    "automation",
    "baileys",
    "buttons",
    "interactive"
  ],
  "homepage": "https://github.com/julzkeceabiez/julzaexce-baileys",
  "license": "MIT",
  "author": "Rajeh Taher (upstream Baileys); fork changes listed in CHANGELOG.md",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./WAProto": "./WAProto/index.js",
    "./WAProto/*": "./WAProto/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node ./engine-requirements.js",
    "test": "node ./test/buttons.test.mjs && node ./test/user-resolver.test.mjs"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julzkeceabiez/julzaexce-baileys.git"
  }
}
